<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MyRecipes" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="android:font">@font/heebo_medium</item>
        <item name="fontFamily">@font/heebo</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="android:windowBackground">@color/app_background</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="q">@color/app_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="CustomTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/heebo_medium</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="MaterialAlertDialog_Rounded" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance_Dialog_Rounded</item>
        <item name="colorAccent">#E53935</item>
        <item name="colorPrimary">#E53935</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.MaterialComponents.Button.TextButton.Dialog.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.MaterialComponents.Button.TextButton.Dialog.Negative</item>
    </style>

    <style name="ShapeAppearance_Dialog_Rounded" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="Widget.MaterialComponents.Button.TextButton.Dialog.Positive" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">#E53935</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/heebo_bold</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
    </style>

    <style name="Widget.MaterialComponents.Button.TextButton.Dialog.Negative" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">#4B5563</item>
        <item name="strokeColor">#E5E7EB</item>
        <item name="android:fontFamily">@font/heebo_medium</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
    </style>
</resources>